{
  "name": "@canonspec/cli",
  "version": "0.1.1",
  "description": "Lay out a Canon set in a project: the definition of the language, the standard library and the manifest naming them",
  "keywords": [
    "canon",
    "specification",
    "requirements",
    "vocabulary"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/prostohz/canonspec",
  "bugs": "https://github.com/prostohz/canonspec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prostohz/canonspec.git",
    "directory": "@canon/cli"
  },
  "type": "module",
  "bin": {
    "canon-cli": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "extension",
    "studio",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@canonspec/lang": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc && node scripts/prose.mjs",
    "prepare": "npm run build",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "install:local": "npm install --no-save ../lang",
    "test": "npm run build && node --test dist/test/*.test.js"
  }
}
